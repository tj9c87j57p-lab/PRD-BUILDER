# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@127.0.0.1:5432/precision_coach_crm"

# Random 32+ byte secret used to encrypt the session cookie. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=""

# Seed-only: used once by `prisma/seed.ts` to create the admin login.
# Not read at runtime after seeding.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Admin"

# Public landing page paid-offer links (your existing Stripe Payment Links).
# An offer card is hidden if its URL isn't set.
PAID_OFFER_ONLINE_COACHING_URL=""
PAID_OFFER_NUTRITION_COACHING_URL=""

# Google Calendar one-way event push for booked calls. Requires a Google Cloud
# project + OAuth client + a one-time consent grant to get a refresh token.
# If any of these are unset, booking still works — the calendar push is
# skipped with a console log instead.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""

# Resend — confirmation/reminder emails for booked calls. If unset, sending
# is skipped with a console log instead (booking still works).
RESEND_API_KEY=""
EMAIL_FROM="Precision Coach <no-reply@precisioncoach.net>"

# Shared secret an external cron service must pass as ?secret= to trigger
# GET /api/reminders. Generate with: openssl rand -hex 32
CRON_SECRET=""
