# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@127.0.0.1:5432/precision_coach_crm"

# Random 32+ byte secret used to encrypt the session cookie. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=""

# Seed-only: used once by `prisma/seed.ts` to create the admin login.
# Not read at runtime after seeding.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Admin"

# Public landing page paid-offer links (your existing Stripe Payment Links).
# An offer card is hidden if its URL isn't set.
PAID_OFFER_ONLINE_COACHING_URL=""
PAID_OFFER_NUTRITION_COACHING_URL=""
