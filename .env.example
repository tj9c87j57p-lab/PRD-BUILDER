# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@127.0.0.1:5432/precision_coach_crm"

# Random 32+ byte secret used to encrypt the session cookie. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=""

# Seed-only: used once by `prisma/seed.ts` to create the admin login.
# Not read at runtime after seeding.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Admin"

# Public landing page paid-offer links (your existing Stripe Payment Links).
# An offer card is hidden if its URL isn't set.
PAID_OFFER_ONLINE_COACHING_URL=""
PAID_OFFER_NUTRITION_COACHING_URL=""

# Cloudflare R2 — lead magnet file storage. If any of these are unset,
# uploads fall back to local disk (fine for local dev, NOT durable on a real
# deploy — files will be lost on redeploy/cold start without R2 configured).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
# The public base URL files are served from — either the bucket's r2.dev
# public URL or a custom domain mapped to it, no trailing slash.
R2_PUBLIC_URL=""

# Google Calendar one-way event push for booked calls. Client ID/Secret are
# shared by every coach (one registered OAuth app); each Coach row can carry
# its own refresh token (set via the admin Coaches screen) for its own
# calendar. GOOGLE_REFRESH_TOKEN here is only a fallback used when a Coach
# has no refresh token of its own. If Client ID/Secret are unset, or a
# coach has no refresh token anywhere, booking still works — the calendar
# push is skipped with a console log instead.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""

# Resend — confirmation/reminder emails for booked calls. If unset, sending
# is skipped with a console log instead (booking still works).
RESEND_API_KEY=""
EMAIL_FROM="Precision Coach <no-reply@precisioncoach.net>"

# Shared secret an external cron service must pass as ?secret= to trigger
# GET /api/reminders. Generate with: openssl rand -hex 32
CRON_SECRET=""
