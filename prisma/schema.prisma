generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Contact {
  id              String    @id @default(cuid())
  name            String
  email           String?
  phone           String?
  instagramHandle String?
  source          String?
  tags            String[]  @default([])
  notes           String?
  lastContactAt   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deals           Deal[]
  tasks           Task[]
  submissions     LeadMagnetSubmission[]
}

model Stage {
  id        String   @id @default(cuid())
  name      String
  position  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deals     Deal[]
}

model Deal {
  id                String    @id @default(cuid())
  contactId         String
  contact           Contact   @relation(fields: [contactId], references: [id], onDelete: Restrict)
  stageId           String
  stage             Stage     @relation(fields: [stageId], references: [id], onDelete: Restrict)
  valueCents        Int
  expectedCloseDate DateTime?
  notes             String?
  stageEnteredAt    DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  tasks             Task[]

  @@index([contactId])
  @@index([stageId])
}

model Task {
  id          String    @id @default(cuid())
  contactId   String?
  contact     Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  dealId      String?
  deal        Deal?     @relation(fields: [dealId], references: [id], onDelete: SetNull)
  description String
  dueAt       DateTime
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([contactId])
  @@index([dealId])
  @@index([completedAt, dueAt])
}

model LeadMagnet {
  id            String   @id @default(cuid())
  title         String
  description   String
  fileUrl       String
  coverImageUrl String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  submissions   LeadMagnetSubmission[]
}

model LeadMagnetSubmission {
  id           String     @id @default(cuid())
  leadMagnetId String
  leadMagnet   LeadMagnet @relation(fields: [leadMagnetId], references: [id], onDelete: Cascade)
  contactId    String
  contact      Contact    @relation(fields: [contactId], references: [id], onDelete: Cascade)
  submittedAt  DateTime   @default(now())

  @@index([leadMagnetId])
  @@index([contactId])
}
